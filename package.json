{
  "name": "droplets-dsh",
  "version": "0.4.45",
  "private": true,
  "description": "Droplets for DeepSeek Harness: 信息流 + 收件箱 + 知识库三空间,原生 AI 伴读与 Agent 工具",
  "license": "GPL-3.0-only",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "rss",
    "read-later",
    "knowledge-base",
    "droplets"
  ],
  "engines": {
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --import ./tests/register-peers.mjs --test 'tests/*.test.mjs'",
    "prepack": "npm run build && npm test",
    "check": "npm run build && npm test && git diff --exit-code -- index.js client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "meta": {
      "title": "Droplets",
      "description": "信息流、收件箱与知识库三空间:订阅阅读、稍后处理、Markdown 知识库,配原生 AI 伴读与 Agent 工具"
    }
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "dompurify": "^3.2.6",
    "fast-xml-parser": "^5.2.5",
    "fflate": "^0.8.2",
    "ip-address": "^10.0.1",
    "lucide-react": "^1.77.0",
    "pdfjs-dist": "^6.2.108",
    "undici": "^7.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || 4.1.0",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
